---
import BaseLayout from "../layouts/base.astro";
import { GetAllProjects, GetAllUsers } from "../utils/admin.ts";
import "../styles/admin.css";
import {
    GetHackatimeProjects,
    type HackatimeProject,
} from "../utils/hackatime";
import { formatSeconds } from "../utils/time";

// get error from cookies
const error = Astro.cookies.get("flash_error")?.value;
if (error) {
    Astro.cookies.delete("flash_error", { path: "/" });
}

async function batchedFetch<T>(
    items: string[],
    fn: (item: string) => Promise<T>,
    batchSize = 10,
): Promise<T[]> {
    const results: T[] = [];
    for (let i = 0; i < items.length; i += batchSize) {
        const batch = items.slice(i, i + batchSize);
        const batchResults = await Promise.all(batch.map(fn));
        results.push(...batchResults);
    }
    return results;
}

const users = GetAllUsers();
const projects = GetAllProjects();

// dict of project: hackatime seconds
var projectTimeSpent: { [key: string]: number } = {};

const hackDataResults = await batchedFetch(
    users.map((u) => u.slackId),
    (slackId) => GetHackatimeProjects(slackId),
    10,
);

for (let i = 0; i < users.length; i++) {
    const user = users[i];
    const hackData = hackDataResults[i];

    var hackatimeProjects: HackatimeProject[];
    if (hackData.ok) {
        hackatimeProjects = hackData.projects || [];
    } else {
        hackatimeProjects = [];
    }

    for (const project of projects.filter(
        (p) => p.authorSlackId === user.slackId,
    )) {
        var timeSpent = 0;
        var hackatimeProjectNames = JSON.parse(project.hackatimeProjects);

        for (const hackatimeProject of hackatimeProjects) {
            if (hackatimeProjectNames.includes(hackatimeProject.name)) {
                timeSpent += hackatimeProject.total_seconds || 0;
            }
        }

        projectTimeSpent[project.id] = timeSpent;
    }
}

const totalTimeSpent = Object.values(projectTimeSpent).reduce(
    (a, b) => a + b,
    0,
);
---

<BaseLayout title="Admin" hideFooter={true}>
    {
        error && (
            <div
                class="surface dangerbg"
                style="width: 100%; border-radius: 0; padding: 1rem; margin-bottom: 1rem;"
            >
                <p>{error}</p>
            </div>
        )
    }
    <div style="margin:2rem;">
        <h2>Stats</h2>
        <ul>
            <li>Total Users: {users.length}</li>
            <li>Total Projects: {projects.length}</li>
            <li>Total Time logged: {formatSeconds(totalTimeSpent)}</li>
        </ul>
        <h2>Users ({users.length})</h2>
        <table>
            <thead>
                <tr>
                    <th>Avatar</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Slack ID</th>
                    <th>Signed Up</th>
                    <th>Hackatime linked</th>
                    <th>Project number</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {
                    users.map((user) => (
                        <tr>
                            <td>
                                <img
                                    src={user.avatar}
                                    alt={user.firstName}
                                    width={32}
                                    height={32}
                                    style={{ borderRadius: "50%" }}
                                />
                            </td>
                            <td>
                                {user.firstName} {user.lastName}
                            </td>
                            <td>{user.email}</td>
                            <td>
                                <code>{user.slackId}</code>
                            </td>
                            <td>{user.createdAt.toLocaleDateString()}</td>
                            <td>{user.hackatimeLinked ? "yes" : "no"}</td>
                            <td>
                                {
                                    projects.filter(
                                        (p) => p.authorSlackId === user.slackId,
                                    ).length
                                }
                            </td>
                            <td class="unlimited-width">
                                <a
                                    class="button warnbg"
                                    id={`delete-user-${user.slackId}`}
                                >
                                    unlink hackatime
                                </a>
                                <a
                                    class="button"
                                    href={`/admin/user/${user.slackId}`}
                                >
                                    view details
                                </a>
                            </td>
                        </tr>
                    ))
                }
            </tbody>
        </table>
        <h2>Projects ({projects.length})</h2>
        <table>
            <thead>
                <tr>
                    <th>Image</th>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Hackatime time logged</th>
                    <th>Author</th>
                    <th>Created</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {
                    projects.map((project) => (
                        <tr>
                            <td>
                                <img
                                    src={
                                        project.projectScreenshot ||
                                        "/assets/images/bonk.png"
                                    }
                                    alt={project.projectName}
                                    width={32}
                                    height={32}
                                    style={{ borderRadius: "50%" }}
                                />
                            </td>
                            <td>{project.projectName}</td>
                            <td>{project.projectDescription}</td>
                            <td>
                                {formatSeconds(
                                    projectTimeSpent[project.id] || 0,
                                )}
                            </td>
                            <td>
                                {users.find(
                                    (u) => u.slackId === project.authorSlackId,
                                )?.firstName || "Unknown"}
                            </td>
                            <td>{project.createdAt.toLocaleDateString()}</td>
                            <td class="unlimited-width">
                                <a
                                    class="button dangerbg"
                                    id={`delete-project-${project.id}`}
                                >
                                    delete project
                                </a>
                                <a
                                    class="button"
                                    href={`/admin/project/${project.id}`}
                                >
                                    view details
                                </a>
                            </td>
                        </tr>
                    ))
                }
            </tbody>
        </table>
    </div>
    <script>
        document.querySelectorAll("[id^='delete-user-']").forEach((button) => {
            button.addEventListener("click", async () => {
                const slackId = button.id.replace("delete-user-", "");
                const response = await fetch(
                    `/api/admin/unlink-hackatime?slackId=${slackId}`,
                    {
                        method: "POST",
                    },
                );
                if (response.ok) {
                    location.reload();
                } else {
                    console.error(
                        "Failed to delete user:",
                        response.statusText,
                    );
                }
            });
        });

        document
            .querySelectorAll("[id^='delete-project-']")
            .forEach((button) => {
                button.addEventListener("click", async () => {
                    const projectId = button.id.replace("delete-project-", "");
                    const response = await fetch(
                        `/api/admin/delete-project?projectId=${projectId}`,
                        {
                            method: "POST",
                        },
                    );
                    if (response.ok) {
                        location.reload();
                    } else {
                        console.error(
                            "Failed to delete project:",
                            response.statusText,
                        );
                    }
                });
            });
    </script>
</BaseLayout>
