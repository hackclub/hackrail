import "../styles/test.css";
---

<BaseLayout title="test">
    <div class="content">
        <div class="header"></div>

        <p class="glyph-run" style="font-size: 3rem; word-wrap: break-word;">
            {normal}
        </p>

        <div
            class="colorpalette"
            style="display: flex; flex-wrap: wrap; gap: 10px;"
        >
            <div
                class="green"
                style="background-color: var(--green); width: 100px; height: 100px;"
            ></div>
            <div
                class="green-bright"
                style="background-color: var(--green-bright); width: 100px; height: 100px;"
            ></div>
            <div
                class="green-dim"
                style="background-color: var(--green-dim); width: 100px; height: 100px;"
            ></div>
            <div
                class="bg"
                style="background-color: var(--bg); width: 100px; height: 100px;"
            ></div>
            <div
                class="bg-elevated"
                style="background-color: var(--bg-elevated); width: 100px; height: 100px;"
            ></div>
            <div
                class="bg-inset"
                style="background-color: var(--bg-inset); width: 100px; height: 100px;"
            ></div>
            <div
                class="fg"
                style="background-color: var(--fg); width: 100px; height: 100px;"
            ></div>
            <div
                class="fg-muted"
                style="background-color: var(--fg-muted); width: 100px; height: 100px;"
            ></div>
            <div
                class="fg-subtle"
                style="background-color: var(--fg-subtle); width: 100px; height: 100px;"
            ></div>
            <div
                class="border"
                style="background-color: var(--border); width: 100px; height: 100px;"
            ></div>
            <div
                class="border-strong"
                style="background-color: var(--border-strong); width: 100px; height: 100px;"
            ></div>
            <div
                class="warn"
                style="background-color: var(--warn); width: 100px; height: 100px;"
            ></div>
            <div
                class="danger"
                style="background-color: var(--danger); width: 100px; height: 100px;"
            ></div>
        </div>
    </div>
</BaseLayout>
