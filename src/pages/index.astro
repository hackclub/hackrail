---
import BaseLayout from "../layouts/base.astro";
import "../styles/landing.css";
import { type Card } from "../components/SillyCarousel.astro";
import { Image } from "astro:assets";

import cableCarRaw from "../assets/images/cable_car.svg?raw";
import hackclubLogo from "../assets/misc/hackclub.svg";
// images
import signImage from "../assets/images/railwaysign.png";
import prahaCentralImage from "../assets/images/praha_central.jpg";
import SjInsideImage from "../assets/images/sj_inside.jpg";
import hackclubbersImage from "../assets/images/hackclubbers.png";
import trainDoorImage from "../assets/images/train_door.jpg";
import trainOutsideImage from "../assets/images/train_outside.jpg";
import highSpeedTrainImage from "../assets/images/high_speed_train.jpg";
import stockholmImage from "../assets/images/stockholm.jpg";
import swissImage from "../assets/images/swiss.png";
import interrailImage from "../assets/images/interrail.webp";
import nycMusicImage from "../assets/images/nycmusic.png";
import trainlineImage from "../assets/images/trainline.png";
import yourProjectImage from "../assets/images/yourproject.webp";

// train logos
import sjLogo from "../assets/images/logos/sj.svg";
import sncfLogo from "../assets/images/logos/sncf.svg";
import sbbLogo from "../assets/images/logos/sbb.svg";
import dbLogo from "../assets/images/logos/db.svg";
import interrailLogo from "../assets/images/logos/interrail.svg";

import Map from "../components/Map.tsx";
import SillyCarousel from "../components/SillyCarousel.astro";

// arrowwwws
import Arrow from "../assets/images/cutearrow.png";
import ArrowTwo from "../assets/images/arrow2.png";
import DownArrow from "../assets/images/downarrow.png";
import { GetUserFromCookies } from "../utils/auth";

const cards: Card[] = [
    {
        title: "see very cool trains!",
        image: prahaCentralImage,
        alt: "train at praha central station",
    },
    {
        title: "go meet other hackclubbers!",
        image: hackclubbersImage,
        alt: "picture of the inside of the berlin to stockholm night train",
    },
    {
        title: "take iconic rides!",
        image: swissImage,
        alt: "picture of the swiss alps",
    },
    {
        title: "travel in style!",
        image: trainDoorImage,
        alt: "train door opened with sj's logo & stockholm written on it",
    },
    {
        title: "get on wild journeys!",
        image: trainOutsideImage,
        alt: "picture taken from the window of a train",
    },
    {
        title: "try high speed rail!",
        image: highSpeedTrainImage,
        alt: "french high speed train",
    },
    {
        title: "go to cities you always dreamt of :O",
        image: stockholmImage,
        alt: "picture of a building in stockholm",
    },
];

const projectCards: Card[] = [
    {
        title: "generative art",
        image: nycMusicImage,
        alt: "screenshot of trainjazz.com website",
        description: "make generative art like music based on data!",
    },
    {
        title: "train booking engine",
        image: trainlineImage,
        alt: "screenshot of trainline.com website",
        description:
            "make a better train booking engine for trains in your home country!",
    },
    {
        title: "interrail pass recap",
        image: interrailImage,
        alt: "picture of a train pass",
        description:
            'make a website that generates a "wrapped" of your interrail journey!',
    },
    {
        title: "anything else!",
        image: yourProjectImage,
        alt: "no alt",
        description: "make your own project! the possibilities are endless!",
    },
];

// get error from cookies
const error = Astro.cookies.get("flash_error")?.value;
if (error) {
    Astro.cookies.delete("flash_error", { path: "/" });
}

// check if user is logged in
const user = await GetUserFromCookies(Astro.cookies);
var isLoggedIn = false;
if (user) {
    isLoggedIn = true;
}
---

<BaseLayout title="hackrail">
    {error && (
        <div
            class="surface dangerbg"
            style="width: 100%; border-radius: 0; padding: 1rem;"
        >
            <p>{error}</p>
        </div>
    )}
    <main>
        <div class="deadline-container">
            <div class="deadline">
                <p class="deadline-p">
                    {new Date("2026-11-30T23:59:59Z").getTime() -
                        new Date().getTime() >
                    0
                        ? `${Math.floor(
                              (new Date("2026-11-30T23:59:59Z").getTime() -
                                  new Date().getTime()) /
                                  (1000 * 60 * 60 * 24),
                          )} days left!`
                        : "deadline has passed!"}
                </p>
            </div>
        </div>
        <div class="header">
            <div class="title-container">
                <a href="https://hackclub.com">
                    <Image
                        src={hackclubLogo}
                        class="hackclub-logo"
                        alt="hackclub logo"
                    />
                </a>
                <span class="icon" set:html={cableCarRaw} />
                <h1 class="title">hackrail</h1>
                <p class="subtitle">ship projects ß get on trains</p>
                <a class="button big" href="/login">
                    <span class="button-text">
                        {isLoggedIn ? "Enter the station" : "Get started now!"}
                    </span>
                </a>
                <p class="pre">Ran by Alice & Barnav!</p>
            </div>
            <div class="spacer">
                <div class="mapdesc-cont">
                    <div class="mapdesc">
                        <p class="mapdesc-text">
                            This is a live map of trains in finland! Hover a
                            train to see its real number!
                        </p>
                        <Image
                            src={Arrow}
                            class="arrow"
                            alt="arrow showing the map"
                        />
                    </div>
                </div>
            </div>
            <div class="exp-container">
                <Map client:load />
            </div>
        </div>
        <SillyCarousel ideas={false} direction="right" cards={cards} />
        <div class="expl-container">
            <div class="expl">
                <h2 class="expl-title">what is hackrail?</h2>
                <div class="cards">
                    <div class="row">
                        <div class="first-card expl-card">
                            <h3 class="exp-title">
                                ship projects that use{" "}
                                <em class="italic">open source train data</em>
                            </h3>
                            <div class="sncf-logo logo-container">
                                <Image
                                    src={sncfLogo}
                                    class="logo"
                                    alt="sncf logo"
                                />
                            </div>
                            <div class="sbb-logo logo-container">
                                <Image
                                    src={sbbLogo}
                                    class="logo"
                                    alt="sbb logo"
                                />
                            </div>
                            <div class="sj-logo logo-container">
                                <Image
                                    src={sjLogo}
                                    class="logo"
                                    alt="sj logo"
                                />
                            </div>
                            <div class="db-logo logo-container">
                                <Image
                                    src={dbLogo}
                                    class="logo"
                                    alt="db logo"
                                />
                            </div>
                        </div>
                    </div>
                    <div class="mobilearrow-container">
                        <Image
                            src={DownArrow}
                            class="mobilearrow"
                            alt="arrow going down"
                        />
                    </div>
                    <div class="expl-end">
                        <div class="expl-arrow-container">
                            <Image
                                src={ArrowTwo}
                                class="expl-arrow"
                                alt="arrow showing the second card"
                            />
                        </div>
                        <div class="second-card expl-card">
                            <h3 class="exp-title">
                                get money for train tickets & train passes
                            </h3>
                            <div class="interrail-logo logo-container">
                                <Image
                                    src={interrailLogo}
                                    class="logo"
                                    alt="interrail logo"
                                />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="sign">
                <Image src={signImage} class="sign-image" alt="railway sign" />
            </div>
            <div class="ideas">
                <h2 class="ideas-title">what can you make?</h2>
                <div class="ideas-carousel">
                    {projectCards.map((card) => {
                        return (
                            <div class="idea-card">
                                <Image
                                    src={card.image}
                                    alt={card.alt}
                                    class="idea-card-image"
                                />
                                <h3 class="idea-card-title">{card.title}</h3>
                                <p class="idea-card-desc">{card.description}</p>
                            </div>
                        );
                    })}
                </div>
            </div>
        </div>
        <div class="faq-container">
            <div class="faq">
                <h2 class="faq-title">
                    FAQ<em id="time">00:00:00</em>
                    <div class="faq-questions">
                        <details class="faq-question">
                            <summary class="faq-question-title">
                                when is this happening?
                            </summary>
                            <p class="faq-question-desc">
                                hackrail runs until the 30th of nov 2026! you
                                can submit any projects you make(or have made)
                                until then!
                            </p>
                        </details>
                        <details class="faq-question">
                            <summary class="faq-question-title">
                                what is hackclub?
                            </summary>
                            <p class="faq-question-desc">
                                Hack Club is a 501(c)(3) nonprofit, dedicated to
                                getting teenagers into the world of tech! Hack
                                Club runs events like this all the time, for
                                teenagers, by teenagers!
                            </p>
                        </details>
                        <details class="faq-question">
                            <summary class="faq-question-title">
                                who can participate?
                            </summary>
                            <p class="faq-question-desc">
                                anyone aged 13-18 (18 included) can join! its
                                totally free and you get cool stuff!
                            </p>
                        </details>
                        <details class="faq-question">
                            <summary class="faq-question-title">
                                what is interrail
                            </summary>
                            <p class="faq-question-desc">
                                interrail is a kind of train pass that allows
                                you to take any train in europe for free (most
                                of the time).
                            </p>
                        </details>
                        <details class="faq-question">
                            <summary class="faq-question-title">
                                can i only participate if i'm in europe?
                            </summary>
                            <p class="faq-question-desc">
                                no, everyone can participate! (theres even
                                trains in the us somehow) we might not have
                                prizes for your region though, but you can
                                suggest new things!
                            </p>
                        </details>
                        <details class="faq-question">
                            <summary class="faq-question-title">
                                what can i get exactly?
                            </summary>
                            <p class="faq-question-desc">
                                click on the "Get started" button to access the
                                platform & get all the details :)
                            </p>
                        </details>
                        <details class="faq-question">
                            <summary class="faq-question-title">
                                can i only submit projects that use open source
                                train data?
                            </summary>
                            <p class="faq-question-desc">
                                no, we have multiple tiers and you can submit
                                any other project you want! but the ones that
                                follow the theme will get better prizes, see
                                more infos on tiers in #hackrail or on the
                                platform!
                            </p>
                        </details>
                    </div>
                </h2>
            </div>
            <script type="text/javascript">
                // update the time in the faq title with the current time every second
                setInterval(() => {
                    const timeElement = document.getElementById("time");
                    const now = new Date();
                    const hours = now.getHours().toString().padStart(2, "0");
                    const minutes = now
                        .getMinutes()
                        .toString()
                        .padStart(2, "0");
                    const seconds = now
                        .getSeconds()
                        .toString()
                        .padStart(2, "0");
                    timeElement.textContent = `${hours}:${minutes}:${seconds}`;
                }, 1000);
            </script>
        </div>
    </main>
</BaseLayout>
