---
import { GetProjectFromId } from "../../../utils/projects";
import BaseLayout from "../../../layouts/base.astro";
import "../../../styles/admin.css";
import { getAriStatus } from "../../../utils/ari";
import { GetMissingUnifiedFields } from "../../../utils/airtable";

// get error from cookies
const error = Astro.cookies.get("flash_error")?.value;
if (error) {
    Astro.cookies.delete("flash_error", { path: "/" });
}

const { slug } = Astro.params;

const project = await GetProjectFromId(slug || "");

if (!project) {
    Astro.cookies.set("flash_error", "Project not found", {
        path: "/",
        maxAge: 10,
    });

    return Astro.redirect("/admin");
}

const ariStatus = project.ariSubmissionId
    ? await getAriStatus(String(project.id))
    : null;

// required unified fields that would go to airtable empty
const missingForUnified = project.approved
    ? await GetMissingUnifiedFields(project.id)
    : [];
---

<BaseLayout title={project.projectName} hideFooter={true}>
    {error && (
        <div
            class="surface dangerbg"
            style="width: 100%; border-radius: 0; padding: 1rem; margin-bottom: 1rem;"
        >
            <p>{error}</p>
        </div>
    )}
    <div class="content">
        <div class="project-state-toggle">
            <h2>
                project status: {
                    project.approved
                        ? "approved"
                        : project.rejected
                          ? "rejected"
                          : project.shipped
                            ? "shipped"
                            : "unshipped"
                }
            </h2>
            <p class="pre">toggle project status:</p>
            <div class="buttons-group">
                <a
                    class="button fgbg"
                    href={`/admin/project/${project.id}/change-status?status=unshipped`}
                    >unshipped</a
                >
                <a
                    class="button warnbg"
                    href={`/admin/project/${project.id}/change-status?status=unreviewed`}
                    >unreviewed</a
                >
                <a
                    class="button greenbg"
                    href={`/admin/project/${project.id}/change-status?status=approved`}
                    >accepted</a
                >
                <a
                    class="button dangerbg"
                    href={`/admin/project/${project.id}/change-status?status=rejected`}
                    >rejected</a
                >
            </div>
        </div>
        <div class="project-header">
            <h1 class="project-title">
                {project.projectName} - {project.id}
            </h1>
        </div>
        <p class="pre">description:</p>
        <p>{project.projectCodeUrl}</p>
        <p class="pre">created at:</p>
        <p>{project.createdAt}</p>
        <p class="pre">slack id:</p>
        <p>{project.authorSlackId}</p>
        <a class="button" href={`/admin/user/${project.authorSlackId}`}
            >View Author</a
        >

        <p class="pre">project screenshots:</p>
        <img
            src={project.projectScreenshot}
            alt="screenshot 1"
            width="512"
            height="350"
        />
        <p class="pre">project code url:</p>
        <p>{project.projectCodeUrl}</p>
        <p class="pre">project playable url:</p>
        <p>{project.projectPlayableUrl}</p>
        <p class="pre">project description:</p>
        <p>{project.projectDescription}</p>
        <p class="pre">project hackatime projects:</p>
        <p>{project.hackatimeProjects}</p>
        <p>shipped: {project.shipped}</p>
        <p>rejected: {project.rejected}</p>
        <p>approved: {project.approved}</p>
        <p class="pre">ari submission id:</p>
        <p>{project.ariSubmissionId || "not submitted"}</p>
        {
            ariStatus && (
                <p>
                    ari status: {ariStatus.phase}
                    {ariStatus.decision ? ` / ${ariStatus.decision}` : ""}
                </p>
            )
        }
        {
            project.approved && (
                <div class="balance-change-form" style="margin-top: 2rem;">
                    <h2>Airtable</h2>
                    <p class="pre">record:</p>
                    <p>{project.airtableRecordId || "not synced"}</p>
                    <p class="pre">missing for unified:</p>
                    <p
                        style={
                            missingForUnified.length > 0
                                ? "color: var(--warn);"
                                : undefined
                        }
                    >
                        {missingForUnified.length > 0
                            ? missingForUnified.join(", ")
                            : "nothing, ready for unified"}
                    </p>
                    <form method="POST" action="/api/admin/airtable-sync">
                        <input
                            type="hidden"
                            name="projectId"
                            value={project.id}
                        />
                        <button class="button warnbg" type="submit">
                            {project.airtableRecordId
                                ? "update airtable record"
                                : "push to airtable"}
                        </button>
                    </form>
                </div>
            )
        }
        <p class="pre">override hours spent:</p>
        <p>{project.overrideHoursSpent}</p>
        <p class="pre">override hours spent reason:</p>
        <p>{project.overrideHoursSpentReason}</p>
    </div>
</BaseLayout>
