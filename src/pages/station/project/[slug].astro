---
import { GetUserFromCookies } from "../../../utils/auth";
import {
    GetProjectFromId,
    GetProjectStatus,
    SafeUrl,
} from "../../../utils/projects";
import BaseLayout from "../../../layouts/base.astro";
import "../../../styles/project.css";
import { Image } from "astro:assets";
import {
    GetHackatimeProjects,
    type HackatimeProject,
} from "../../../utils/hackatime";
import type { Review } from "../../../db/schema";
import { GetReviewsForProject } from "../../../utils/reviews";

import { GetUserFromSlackId } from "../../../utils/admin";
import UserHeader from "../../../components/UserHeader.astro";
import FixedText from "../../../components/FixedText.astro";
import { formatSeconds } from "../../../utils/time";
import { GetLatestApproval, GetPayoutForProject } from "../../../utils/payouts";

const { slug } = Astro.params;

const user = await GetUserFromCookies(Astro.cookies);
const project = await GetProjectFromId(slug || "");

const hackData = await GetHackatimeProjects(project?.authorSlackId || "");
var hackatimeProjects: HackatimeProject[];
if (hackData.ok) {
    hackatimeProjects = hackData.projects || [];
} else {
    hackatimeProjects = [];
}

var totalTimeSpent = 0;
for (const hackatimeProject of hackatimeProjects) {
    const projectHackatimeNames = JSON.parse(
        project?.hackatimeProjects || "[]",
    );
    if (projectHackatimeNames.includes(hackatimeProject.name)) {
        totalTimeSpent += hackatimeProject.total_seconds || 0;
    }
}

if (!project) {
    Astro.cookies.set("flash_error", "Project not found", {
        path: "/",
        maxAge: 10,
    });

    if (!user) {
        return Astro.redirect("/");
    }

    return Astro.redirect("/station/home");
}

const isCurrentUserAuthor = project.authorSlackId === user?.slackId;

var authorUser;

if (!isCurrentUserAuthor) {
    authorUser = GetUserFromSlackId(project.authorSlackId);
} else {
    authorUser = user;
}

if (!authorUser) {
    Astro.cookies.set("flash_error", "Author not found", {
        path: "/",
        maxAge: 10,
    });

    if (!user) {
        return Astro.redirect("/");
    }

    return Astro.redirect("/station/home");
}

// now fetch reviews if this is the project's author

var reviews: Review[] = [];

if (isCurrentUserAuthor) {
    const reviewR = await GetReviewsForProject(project.id);
    if (reviewR) {
        reviews = reviewR || [];
    }
}

const status = GetProjectStatus(project);
const statusClass = {
    approved: "greenbg",
    rejected: "dangerbg",
    "in review": "warnbg",
    unshipped: "fgbg",
}[status];

// colour of a timeline event, matches the status badge colours
function toneFor(type: string) {
    if (type == "approved") return "green";
    if (type == "warning" || type == "pending") return "warn";
    if (type == "information") return "info";
    return "danger";
}

function labelFor(type: string, dataType?: string) {
    switch (dataType) {
        case "approval":
            return "approved";
        case "rejection":
            return "rejected";
        case "changes_requested":
            return "changes requested";
        case "fraud":
            return "flagged";
        case "reverted":
            return "back in review";
        case "payout":
            return "payout";
    }
    return type == "information" ? "update" : type;
}

function formatEventDate(date: Date) {
    const day = date.toLocaleDateString("en-GB", {
        day: "numeric",
        month: "short",
        year: "numeric",
    });
    const time = date.toLocaleTimeString("en-GB", {
        hour: "2-digit",
        minute: "2-digit",
    });
    return `${day}, ${time}`;
}

const codeUrl = SafeUrl(project.projectCodeUrl);

const payout = isCurrentUserAuthor ? GetPayoutForProject(project.id) : null;
const approvedAt =
    payout && (GetLatestApproval(project.id)?.approvedAt ?? payout.createdAt);
const ticketClass = payout
    ? ({ 1: "1st", 2: "2nd", 3: "3rd" }[payout.tier] ?? `${payout.tier}th`) +
      " class"
    : "";
const shortDate = (date: Date) =>
    date.toLocaleDateString("en-GB", { day: "numeric", month: "short" });
const playableUrl = SafeUrl(project.projectPlayableUrl);
---

<BaseLayout title={project.projectName} hideFooter={true}>
    {user && <UserHeader user={authorUser} absolute={true} />}
    <div class="main-content">
        <div class="left-container" style="flex: 1;">
            <div class="project-image">
                <img
                    src={project.projectScreenshot}
                    alt={project.projectName}
                    class="project-screenshot"
                />
                <div class="image-fade"></div>
                {payout && approvedAt && (
                    <div class="ticket">
                        <div class="ticket-main">
                            <div class="ticket-row">
                                <p class="ticket-name">
                                    <FixedText text={project.projectName} />
                                </p>
                                <p class="ticket-class">{ticketClass}</p>
                            </div>
                            <p>
                                {shortDate(project.createdAt)} to{" "}
                                {shortDate(approvedAt)}
                            </p>
                            <p>
                                {payout.hours}h at {payout.rate} tracks/h
                            </p>
                        </div>
                        <div class="ticket-stub">
                            <p class="ticket-amount">{payout.amount}</p>
                            <p class="ticket-currency">=</p>
                        </div>
                    </div>
                )}
            </div>
            <div class="project-content">
                <div class="project-header">
                    <h1 class="project-title limited">{project.projectName}</h1>
                    <p class="project-desc limited">
                        {project.projectDescription}
                    </p>
                </div>
                {(codeUrl || playableUrl) && (
                    <div class="project-links">
                        {playableUrl && (
                            <a
                                class="project-link"
                                href={playableUrl}
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                <span class="project-link-text">try it</span>
                                <span class="project-link-arrow">…</span>
                            </a>
                        )}
                        {codeUrl && (
                            <a
                                class="project-link"
                                href={codeUrl}
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                <span class="project-link-text">view code</span>
                                <span class="project-link-arrow">…</span>
                            </a>
                        )}
                    </div>
                )}
                {isCurrentUserAuthor &&
                    !project.approved &&
                    !project.shipped && (
                        <div class="row smolgap vcenter">
                            <a
                                class="button warnbg"
                                href={`/station/project/${project.id}/edit`}
                            >
                                edit
                            </a>
                            <a
                                class="button dangerbg"
                                href={`/station/project/${project.id}/delete`}
                            >
                                delete
                            </a>
                            <a
                                class="button greenbg"
                                href={`/station/project/${project.id}/ship${project.rejected ? "?reship=true" : ""}`}
                            >
                                {project.rejected ? "resubmit" : "submit"}
                            </a>
                        </div>
                    )}
                {isCurrentUserAuthor &&
                    (project.shipped || project.approved) && (
                        <div class="row smolgap vcenter">
                            <p class="pre">
                                This project is in review/has been accepted, so
                                it cannot be deleted or edited!
                            </p>
                        </div>
                    )}

                <div class="project-time">
                    <p class="time-value">[ {formatSeconds(totalTimeSpent)}</p>
                </div>
                <div class="project-author">
                    <p class="pre author-header">made by:</p>
                    <div class="row gap vcenter">
                        <div class="author-pfp">
                            <Image
                                class="author-pfp-image"
                                src={authorUser.avatar}
                                width={50}
                                height={50}
                                alt={
                                    authorUser.firstName + "'s profile picture"
                                }
                            />
                        </div>
                        <div class="author-name row smolgap vcenter">
                            <p class="author-name-text">
                                {authorUser.firstName}
                            </p>
                            {isCurrentUserAuthor && <p>(you!)</p>}
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {isCurrentUserAuthor && (
            <div class="right-container">
                <div class="container-content">
                    <div class="project-status">
                        <div class="project-header">
                            <div class="dot-thing">
                                <div class="rectangle"></div>
                                <div class="final-dot">
                                    <div class="project-review-header">
                                        <h1 class="project-status-header">
                                            Project status
                                        </h1>

                                        <div
                                            class={
                                                "project-status-badge" +
                                                " " +
                                                statusClass
                                            }
                                        >
                                            <p class={statusClass}>{status}</p>
                                        </div>
                                    </div>
                                    <div class="dot"></div>
                                </div>
                                <div class="other-rectangle">
                                    <div class="rectangle-fade"></div>
                                </div>
                            </div>
                        </div>
                        <div class="project-details">
                            <h2 class="project-status-subheader">
                                Hackatime projects
                            </h2>
                            <div class="hackatime-board">
                                {hackatimeProjects.map((hackatimeProject) => {
                                    const projectHackatimeNames = JSON.parse(
                                        project?.hackatimeProjects || "[]",
                                    );
                                    if (
                                        projectHackatimeNames.includes(
                                            hackatimeProject.name,
                                        )
                                    ) {
                                        return (
                                            <div class="hackatime-board-row">
                                                <span>
                                                    {hackatimeProject.name}
                                                </span>
                                                <span>
                                                    {formatSeconds(
                                                        hackatimeProject.total_seconds,
                                                    )}
                                                </span>
                                            </div>
                                        );
                                    }
                                })}
                            </div>
                            <h2 class="project-status-subheader">
                                Review timeline
                            </h2>
                            <div class="reviews">
                                {reviews.length === 0 && (
                                    <div class="surface nothing">
                                        <p class="nothing-header">ª</p>
                                        <p class="review-header">
                                            Nothing here yet...
                                        </p>
                                    </div>
                                )}
                                {reviews
                                    .sort(
                                        (a, b) =>
                                            b.createdAt.getTime() -
                                            a.createdAt.getTime(),
                                    )
                                    .map((review) => {
                                        const data = JSON.parse(
                                            review.jsonData || "{}",
                                        );
                                        return (
                                            <div
                                                class={`review-container tone-${toneFor(review.type)}`}
                                            >
                                                <div class="review-top">
                                                    <span class="review-status">
                                                        <FixedText
                                                            text={labelFor(
                                                                review.type,
                                                                data.type,
                                                            )}
                                                        />
                                                    </span>
                                                    <span class="review-date">
                                                        <FixedText
                                                            text={formatEventDate(
                                                                review.createdAt,
                                                            )}
                                                        />
                                                    </span>
                                                </div>
                                                <p class="review-content">
                                                    <FixedText
                                                        text={review.message}
                                                    />
                                                </p>
                                                {data.message && (
                                                    <p class="review-note">
                                                        <FixedText
                                                            text={`“${data.message}”`}
                                                        />
                                                    </p>
                                                )}
                                                {data.type === "approval" &&
                                                    data.hoursApproved > 0 && (
                                                        <span class="review-chip">
                                                            <FixedText
                                                                text={`+${data.hoursApproved}h approved`}
                                                            />
                                                        </span>
                                                    )}
                                                {data.type === "payout" && (
                                                    <span class="review-chip">
                                                        <FixedText
                                                            text={`+${data.amount} tracks`}
                                                        />
                                                    </span>
                                                )}
                                            </div>
                                        );
                                    })}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        )}
    </div>
</BaseLayout>
