---
import { GetUserFromCookies } from "../../../utils/auth";
import { GetProjectFromId } from "../../../utils/projects";
import BaseLayout from "../../../layouts/base.astro";
import "../../../styles/project.css";
import { Image } from "astro:assets";
import {
    GetHackatimeProjects,
    type HackatimeProject,
} from "../../../utils/hackatime";
import { formatSeconds } from "../../../utils/time";

import { GetUserFromSlackId } from "../../../utils/admin";
import UserHeader from "../../../components/UserHeader.astro";

const { slug } = Astro.params;

const user = await GetUserFromCookies(Astro.cookies);
const project = await GetProjectFromId(slug || "");

const hackData = await GetHackatimeProjects(project?.authorSlackId || "");
var hackatimeProjects: HackatimeProject[];
if (hackData.ok) {
    hackatimeProjects = hackData.projects || [];
} else {
    hackatimeProjects = [];
}

var totalTimeSpent = 0;
for (const hackatimeProject of hackatimeProjects) {
    const projectHackatimeNames = JSON.parse(
        project?.hackatimeProjects || "[]",
    );
    if (projectHackatimeNames.includes(hackatimeProject.name)) {
        totalTimeSpent += hackatimeProject.total_seconds || 0;
    }
}

if (!project) {
    Astro.cookies.set("flash_error", "Project not found", {
        path: "/",
        maxAge: 10,
    });

    if (!user) {
        return Astro.redirect("/");
    }

    return Astro.redirect("/station/home");
}

const isCurrentUserAuthor = project.authorSlackId === user?.slackId;

var authorUser;

if (!isCurrentUserAuthor) {
    authorUser = GetUserFromSlackId(project.authorSlackId);
} else {
    authorUser = user;
}
---

<BaseLayout title={project.projectName} hideFooter={true}>
    <UserHeader user={user} />
    <div class="row main-container">
        <div class="content-margin project">
            <div class="project-header">
                <h1 class="project-title">{project.projectName}</h1>
                {
                    isCurrentUserAuthor && (
                        <Fragment>
                            <a
                                href={`/station/project/${project.id}/edit`}
                                class="button warnbg"
                            >
                                Edit Project
                            </a>
                            <a
                                href={`/station/project/${project.id}/delete`}
                                class="button dangerbg"
                            >
                                Delete Project
                            </a>
                        </Fragment>
                    )
                }
            </div>
            <div class="row project-header-container">
                <Image
                    src={project.projectScreenshot || ""}
                    alt={project.projectName}
                    class="project-image"
                    width={512}
                    height={350}
                />
                <div class="cards">
                    <a class="button" href={project.projectPlayableUrl}>
                        demo
                    </a>
                    <a class="button" href={project.projectCodeUrl}> code </a>
                    <div class="time-card surface">
                        <p class="time-card-title">
                            Δ {formatSeconds(totalTimeSpent)}
                        </p>
                    </div>
                </div>
            </div>
            <p class="pre">description:</p>
            <p>{project.projectDescription}</p>
        </div>
        <!-- <div class="author">
            <div class="author-avatar">
                <Image
                    src={authorUser?.avatar || ""}
                    alt={authorUser?.firstName || "Unknown User"}
                    width={64}
                    height={64}
                />
            </div>
            <a href={`/station/user/${authorUser?.slackId}`} class="button">
                View Author</a
            >
        </div> -->
    </div></BaseLayout
>
