---
import { GetProjectFromId } from "../../../../utils/projects";
import { GetUserFromCookies } from "../../../../utils/auth";
import BaseLayout from "../../../../layouts/base.astro";
import "../../../../styles/project.css";
import { Image } from "astro:assets";
import trainGif from "../../../../assets/images/misc/train.gif";

const { id } = Astro.params;

const user = await GetUserFromCookies(Astro.cookies);
if (!user) return Astro.redirect("/login");

const project = await GetProjectFromId(id || "");
if (!project) return Astro.redirect("/station/home");
if (project.authorSlackId !== user.slackId)
    return Astro.redirect("/station/home");
---

<BaseLayout title={`Delete ${project.projectName}`} hideFooter={true}>
    <div class="content-margin">
        <!-- <Image
            class="delete-gif"
            src={trainGif}
            width={200}
            height={200}
            alt="Project Image"
        /> -->
        <div class="project-modal-header">
            <h1 class="project-modal-title">Delete Project</h1>
            <p>
                Are you sure you want to delete this project? This action cannot
                be undone.
            </p>
        </div>
        <div class="project-body">
            <div>
                <form method="POST" action="/api/delete-project">
                    <input type="hidden" name="projectId" value={project.id} />
                    <a
                        class="button warnbg"
                        href={`/station/project/${project.id}`}
                    >
                        cancel
                    </a>
                    <button
                        style="margin-left: 0.5rem;"
                        type="submit"
                        class="button dangerbg"
                    >
                        delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</BaseLayout>
