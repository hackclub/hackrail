---
import { Image } from "astro:assets";
import BaseLayout from "../../../../layouts/base.astro";
import "../../../../styles/home.css";
import "../../../../styles/project.css";
import { GetUserFromCookies } from "../../../../utils/auth.ts";
import { GetProjectFromId } from "../../../../utils/projects";
import amazeImg from "../../../../assets/images/amaze.jpg";
import { GetHackatimeProjects } from "../../../../utils/hackatime";
import { formatSeconds } from "../../../../utils/time.ts";
import MultiCard from "../../../../components/MultipurposeCard.astro";

const { id } = Astro.params;

const user = await GetUserFromCookies(Astro.cookies);
if (!user) return Astro.redirect("/login");
if (!user.hackatimeLinked) return Astro.redirect("/station/link");

const project = await GetProjectFromId(id || "");
if (!project) return Astro.redirect("/station/home");
if (project.authorSlackId !== user.slackId)
    return Astro.redirect("/station/home");

const selectedProjects =
    project.hackatimeProjects === ""
        ? []
        : JSON.parse(project.hackatimeProjects);

const hackatimeProjects = await GetHackatimeProjects(user.slackId || "");

if (
    !hackatimeProjects ||
    hackatimeProjects.ok === false ||
    !hackatimeProjects.projects
) {
    return Astro.redirect(`/error?code=failed_to_fetch_projects`);
}

if (hackatimeProjects.projects.length === 0) {
    return Astro.redirect(`/error?code=no_projects_found`);
}

const initialSeconds = hackatimeProjects.projects
    .filter((p) => selectedProjects.includes(p.name))
    .reduce((t, p) => t + (p.total_seconds || 0), 0);

const error = Astro.cookies.get("flash_error")?.value;
if (error) {
    Astro.cookies.delete("flash_error", { path: "/" });
}
---

<BaseLayout title="Edit Project" hideFooter={true}>
    {error && (
        <div
            class="surface dangerbg"
            style="width: 100%; border-radius: 0; padding: 1rem; margin-bottom: 1rem;"
        >
            <p>{error}</p>
        </div>
    )}
    <div class="separated-container">
        <div class="content-right">
            <h1>edit project †</h1>
            <form
                method="POST"
                action="/api/create-project"
                class="form"
                enctype="multipart/form-data"
            >
                <input type="hidden" name="id" value={project.id} />
                <div class="form-high-group">
                    <div class="form-group">
                        <label for="name">name</label>
                        <input
                            autocomplete="off"
                            type="text"
                            id="name"
                            name="name"
                            value={project.projectName}
                            required
                        />
                    </div>
                    <div class="form-group">
                        <label for="description">description</label>
                        <textarea
                            id="description"
                            name="description"
                            required
                        >{project.projectDescription}</textarea>
                    </div>
                    <div class="form-group">
                        <label for="image">image url</label>
                        <input
                            type="file"
                            id="image"
                            name="image"
                            accept="image/*"
                        />
                    </div>
                </div>
                <div class="form-high-group">
                    <div class="form-group">
                        <label for="githubUrl">github url</label>
                        <input
                            type="url"
                            id="githubUrl"
                            name="githubUrl"
                            value={project.projectCodeUrl}
                            required
                        />
                    </div>
                    <div class="form-group">
                        <label for="liveUrl">playable url</label>
                        <input
                            type="url"
                            id="liveUrl"
                            name="liveUrl"
                            value={project.projectPlayableUrl}
                        />
                    </div>
                </div>
                <div class="form-high-group">
                    <div class="form-group combobox">
                        <label for="hackatimeSearch">hackatime projects</label>
                        <div class="combobox-tags" id="comboboxTags"></div>
                        <input
                            type="text"
                            id="hackatimeSearch"
                            placeholder="search projects..."
                            autocomplete="off"
                        />
                        <input
                            type="hidden"
                            name="hackatimeProjects"
                            id="hackatimeHidden"
                        />
                        <ul
                            class="combobox-list"
                            id="hackatimeList"
                            role="listbox"
                            hidden
                        >
                            {hackatimeProjects.projects.map((p) => (
                                <li
                                    class="combobox-option"
                                    role="option"
                                    data-value={p.name}
                                    data-seconds={p.total_seconds}
                                    data-selected={selectedProjects.includes(
                                        p.name,
                                    )}
                                >
                                    <span class="combobox-option-name">
                                        {p.name}
                                    </span>
                                    {formatSeconds(p.total_seconds) && (
                                        <span class="combobox-option-meta">
                                            {formatSeconds(p.total_seconds)}
                                        </span>
                                    )}
                                </li>
                            ))}
                        </ul>
                    </div>
                </div>
                <div class="buttons-group">
                    <a
                        class="button warnbg"
                        href={`/station/project/${project.id}`}
                    >
                        cancel
                    </a>
                    <button type="submit" class="button">
                        save
                    </button>
                </div>
            </form>
        </div>
        <div class="image-left">
            <div class="fade"></div>
            <div class="previewcard">
                <MultiCard
                    unClickable={true}
                    scale={1.5}
                    item={{
                        id: "preview",
                        name: project.projectName,
                        description: project.projectDescription,
                        itemLink: "",
                        imageUrl:
                            project.projectScreenshot ||
                            "https://upload.wikimedia.org/wikipedia/commons/thumb/c/ca/Den_Haag_Hollands_Spoor.jpg/3840px-Den_Haag_Hollands_Spoor.jpg",
                        chip: true,
                        chipText: formatSeconds(initialSeconds) || "0h 0m",
                    }}
                />
            </div>
            <Image
                src={amazeImg}
                width={700}
                height={1000}
                alt="amaze"
                class="amaze"
            />
        </div>
    </div>
    <script is:inline>
        function formatSecondsClient(seconds) {
            if (!seconds || seconds <= 0) return "0h 0m";
            const hours = Math.floor(seconds / 3600);
            const minutes = Math.floor((seconds % 3600) / 60);
            return `${hours}h ${minutes}m`;
        }

        const imageInput = document.getElementById("image");
        const previewImg = document.querySelector(".previewcard img");

        imageInput.addEventListener("change", (e) => {
            const file = e.target.files[0];
            if (file && file.type.startsWith("image/")) {
                previewImg.src = URL.createObjectURL(file);
            }
        });

        const nameInput = document.getElementById("name");
        const descInput = document.getElementById("description");
        const previewName = document.querySelector(".previewcard h2");
        const previewDesc = document.querySelector(".previewcard .desc");
        const fallbackName = previewName.textContent;
        const fallbackDesc = previewDesc.textContent;

        nameInput.addEventListener("input", (e) => {
            previewName.textContent = e.target.value || fallbackName;
        });

        descInput.addEventListener("input", (e) => {
            previewDesc.textContent = e.target.value || fallbackDesc;
        });

        document.addEventListener("DOMContentLoaded", () => {
            const search = document.getElementById("hackatimeSearch");
            const list = document.getElementById("hackatimeList");
            const hidden = document.getElementById("hackatimeHidden");
            const tagsContainer = document.getElementById("comboboxTags");
            const options = Array.from(
                list.querySelectorAll(".combobox-option"),
            );
            const timeChip = document.querySelector(".previewcard .card-chip");
            const selected = new Set(
                options
                    .filter((o) => o.dataset.selected === "true")
                    .map((o) => o.dataset.value),
            );

            function updateHidden() {
                hidden.value = JSON.stringify([...selected]);
            }

            function updateTimeChip() {
                let totalSeconds = 0;
                for (const name of selected) {
                    const opt = options.find((o) => o.dataset.value === name);
                    if (opt && opt.dataset.seconds) {
                        totalSeconds += parseInt(opt.dataset.seconds, 10) || 0;
                    }
                }
                if (timeChip) {
                    timeChip.textContent = formatSecondsClient(totalSeconds);
                }
            }

            function renderTags() {
                tagsContainer.innerHTML = "";
                for (const name of selected) {
                    const tag = document.createElement("span");
                    tag.className = "combobox-tag";
                    const p = document.createElement("p");
                    p.textContent = name;
                    p.className = "combobox-tag-name";
                    tag.appendChild(p);
                    const remove = document.createElement("button");
                    remove.type = "button";
                    remove.className = "combobox-tag-remove";
                    remove.textContent = "\u00d7";
                    remove.addEventListener("click", () => {
                        selected.delete(name);
                        updateHidden();
                        renderTags();
                        updateTimeChip();
                        const opt = options.find(
                            (o) => o.dataset.value === name,
                        );
                        if (opt) opt.classList.remove("selected");
                    });
                    tag.appendChild(remove);
                    tagsContainer.appendChild(tag);
                }
            }

            function toggleOption(opt) {
                const value = opt.dataset.value;
                if (selected.has(value)) {
                    selected.delete(value);
                    opt.classList.remove("selected");
                } else {
                    selected.add(value);
                    opt.classList.add("selected");
                }
                updateTimeChip();
                updateHidden();
                renderTags();
            }

            search.addEventListener("focus", () => {
                list.hidden = false;
            });

            document.addEventListener("click", (e) => {
                if (!e.target.closest(".combobox")) {
                    list.hidden = true;
                }
            });

            search.addEventListener("input", () => {
                const q = search.value.toLowerCase();
                for (const opt of options) {
                    const name = opt.dataset.value.toLowerCase();
                    opt.style.display = name.includes(q) ? "" : "none";
                }
            });

            for (const opt of options) {
                if (selected.has(opt.dataset.value)) {
                    opt.classList.add("selected");
                }
                opt.addEventListener("click", () => {
                    toggleOption(opt);
                    search.value = "";
                    options.forEach((o) => (o.style.display = ""));
                    search.focus();
                });
            }

            renderTags();
            updateHidden();
            updateTimeChip();
        });

        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape") {
                const list = document.getElementById("hackatimeList");
                if (list) list.hidden = true;
            }
        });
    </script>
</BaseLayout>
