---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/base.astro";
import shopHeaderImage from "../../assets/images/shop.jpg";
import "../../styles/shop.css";
import { GetUserFromCookies } from "../../utils/auth";
import MultiPurposeCard from "../../components/MultipurposeCard.astro";
import type { CardItem } from "../../components/MultipurposeCard.astro";
import DiscountChip from "../../components/DiscountChip.astro";
// load shop items
import { getShopData } from "../../utils/shop";
const shopItems = await getShopData();

const user = await GetUserFromCookies(Astro.cookies);

// cookie error
const error = Astro.cookies.get("flash_error")?.value;
if (error) {
    Astro.cookies.delete("flash_error", { path: "/" });
}

const success = Astro.url.searchParams.get("success");
---

<BaseLayout title="Shop">
    {success && (
        <div
            class="surface greenbg"
            style="width: 100%; border-radius: 0; padding: 1rem;"
        >
            <p>We got your order!</p>
        </div>
    )}
    {error && (
        <div
            class="surface dangerbg"
            style="width: 100%; border-radius: 0; padding: 1rem;"
        >
            <p>{error}</p>
        </div>
    )}
    <div class="shop">
        <div class="shop-image-header">
            <div class="back-button">
                <a class="button warnbg" href="/station/home">
                    {" "}
                    ¬{" "}
                </a>
            </div>
            {}
            <Image
                class="shop-image"
                src={shopHeaderImage}
                width={2000}
                height={500}
                alt="shop header image"
            />
            <div class="shop-image-fadecontainer"></div>
        </div>

        <div class="shop-content">
            <div class="shop-header-again">
                <div class="row shop-title">
                    <h1>Shop!</h1>
                    <p>
                        or should i say overpriced train station convenience
                        store?
                    </p>
                </div>
                <div class="row gap" style="align-items: center;">
                    {user && (
                        <div class="surface warnbg">
                            <p>Balance: {user?.balance} =</p>
                        </div>
                    )}
                    <a class="button greenbg order-btn" href="/station/orders">
                        see your orders
                    </a>
                </div>
                <p class="expl">
                    welcome to the shop! here you can spend your tracks = on
                    real stuff. <br />
                    you earn between 8 to 12 tracks for every hour you spend on
                    your projects! (check the{" "}
                    <a class="inline-link" href="/station/help">
                        guide
                    </a>{" "}
                    for info on tiers)
                </p>
            </div>

            <div class="shop-items">
                {shopItems.items.map((item) => {
                    var priceText = (item.options[0]?.price ?? 0) + " =";
                    if (item.options.length > 1) {
                        priceText = "from " + priceText;
                    }
                    var discount: boolean = false;
                    var discountPercentage: string = "0";
                    item.options.forEach((option) => {
                        if (
                            shopItems.discounts?.find(
                                (d) =>
                                    d["discount-parent-option-id"] ===
                                    option.id,
                            )
                        ) {
                            discount = true;
                            discountPercentage = shopItems.discounts
                                ?.find(
                                    (d) =>
                                        d["discount-parent-option-id"] ===
                                        option.id,
                                )
                                ?.percentage.toString() as string;
                        }
                    });

                    const cardItem: CardItem = {
                        id: item.id,
                        name: item.name,
                        description: item.description,
                        imageUrl: item.image,
                        chip: true,
                        chipText: priceText,
                        itemLink: `/station/shop/${item.id}`,
                    };
                    if (!discount) {
                        return <MultiPurposeCard item={cardItem} />;
                    } else {
                        return (
                            <MultiPurposeCard item={cardItem}>
                                <DiscountChip percentage={discountPercentage} />
                            </MultiPurposeCard>
                        );
                    }
                })}
                <div class="requests">
                    <a href="mailto:alice@hackclub.cc?subject=Shop%20Request">
                        <div class="requests-container surface">
                            <p class="big">?</p>
                            <p>Want something else on here? Suggest it!</p>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </div>
</BaseLayout>
