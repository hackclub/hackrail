---
const { slug } = Astro.params;
import BaseLayout from "../../../layouts/base.astro";
import { getShopData } from "../../../utils/shop";
import "../../../styles/shop.css";
import UserHeader from "../../../components/UserHeader.astro";
import { GetUserFromCookies } from "../../../utils/auth";
import FixedText from "../../../components/FixedText.astro";
import DiscountChip from "../../../components/DiscountChip.astro";

const shopItems = await getShopData();

const shopItemId = slug || "";

const item = shopItems.items.find((item) => item.id === shopItemId);
if (!item) {
    Astro.cookies.set("flash_error", "Shop item not found", {
        path: "/",
        maxAge: 10,
    });

    return Astro.redirect("/station/shop");
}

const user = await GetUserFromCookies(Astro.cookies);
const isGuest = !user;

const balance = user?.balance || 0;

var discount: boolean = false;
var percentage: string = "";
var discountEndDate: string = "";

item.options.forEach((option) => {
    shopItems.discounts?.forEach((discountItem) => {
        if (discountItem["discount-parent-option-id"] === option.id) {
            discount = true;
            // make a new date object with unix discountItem.end and format it to a readable string
            const endDate = new Date(parseInt(discountItem.end));
            discountEndDate = endDate.toLocaleString("en-US", {
                month: "long",
                day: "numeric",
                year: "numeric",
                hour: "numeric",
                minute: "numeric",
                hour12: true,
            });
            percentage = discountItem.percentage.toString();
        }
    });
});

// now we have the item :scheming:
---

<BaseLayout
    title={"Shop - " + item.name}
    embedTitleReplacement={item.name}
    embedDescriptionReplacement={item.description}
    embedImageReplacement={item.image}
>
    <UserHeader user={user} backUrlOverride="/station/shop" />
    <div class="shop-item-page">
        <div class="shop-item-top">
            <div class="shop-item-image-container">
                <img class="shop-item-image" src={item.image} alt={item.name} />
                {discount && <DiscountChip percentage={percentage} />}
            </div>
            {item["extended-description"] != "" && (
                <div class="shop-item-extended surface">
                    <FixedText text={item["extended-description"]} />
                </div>
            )}
        </div>
        <div class="shop-item-details">
            <h1 class="shop-item-title">{item.name}</h1>
            <p class="shop-item-desc">
                <FixedText text={item.description} />
            </p>
            {discount && (
                <div class="surface dangerbg" style="margin-bottom:1rem;">
                    <FixedText
                        text={percentage + " off until " + discountEndDate}
                    />
                </div>
            )}

            <form
                method="POST"
                action="/api/buy"
                class="shop-item-purchase-form"
            >
                <input type="hidden" name="itemId" value={item.id} />

                {item.options.length > 0 && !isGuest && (
                    <>
                        <fieldset class="shop-item-options">
                            <legend>Select an option:</legend>
                            {item.options.map((option, index) => {
                                const discount = shopItems.discounts?.find(
                                    (d) =>
                                        d["discount-parent-option-id"] ===
                                        option.id,
                                );

                                return (
                                    <div class="radio-option">
                                        <input
                                            type="radio"
                                            id={`option-${index}`}
                                            name="optionId"
                                            value={option.id}
                                            checked={index === 0}
                                            data-price={option.price}
                                            required
                                        />
                                        <label for={`option-${index}`}>
                                            {discount ? (
                                                <span class="option-name">
                                                    {option.name} -{" "}
                                                    <span class="strikethrough">
                                                        {option.price.toFixed(
                                                            2,
                                                        )}{" "}
                                                        =
                                                    </span>{" "}
                                                    <span class="discounted-price">
                                                        {discount[
                                                            "new-price"
                                                        ].toFixed(2)}{" "}
                                                        =
                                                    </span>
                                                </span>
                                            ) : (
                                                <span class="option-name">
                                                    {option.name} - $
                                                    {option.price.toFixed(2)}
                                                </span>
                                            )}
                                        </label>
                                    </div>
                                );
                            })}
                        </fieldset>
                        {item.stackable && (
                            <fieldset class="shop-item-options">
                                <legend>How many do you want?</legend>
                                <input
                                    type="number"
                                    name="quantity"
                                    min="1"
                                    value="1"
                                    required
                                />
                            </fieldset>
                        )}
                    </>
                )}
                {isGuest && (
                    <div class="surface warnbg">
                        <p>You must be logged in to purchase this item!</p>
                    </div>
                )}
                {!isGuest && (
                    <div class="gap row purchase-btn-container">
                        <button
                            id="purchase-btn"
                            class="button greenbg"
                            type="submit"
                            data-balance={balance}
                        >
                            Purchase
                        </button>

                        <p
                            id="error-message"
                            class="error-text"
                            style="display: none;"
                        >
                            You don't have enough to purchase this item :(
                        </p>
                    </div>
                )}
            </form>
        </div>
    </div>
    <script is:inline type="module">
        const purchaseBtn = document.getElementById("purchase-btn");
        const errorMessage = document.getElementById("error-message");
        const radioInputs = document.querySelectorAll('input[name="optionId"]');
        const quantityInput = document.querySelector('input[name="quantity"]');

        if (purchaseBtn && radioInputs.length > 0) {
            const balance = parseFloat(purchaseBtn.dataset.balance || "0");

            const updateState = () => {
                const selectedOption = Array.from(radioInputs).find(
                    (input) => input.checked,
                );
                let price = parseFloat(selectedOption?.dataset.price || "0");
                if (quantityInput) {
                    const quantity = parseInt(quantityInput.value || "1");
                    price *= quantity;
                }

                const hasEnoughBalance = balance >= price;

                purchaseBtn.disabled = !hasEnoughBalance;
                purchaseBtn.classList.toggle("disabled", !hasEnoughBalance);

                if (errorMessage) {
                    errorMessage.style.display = hasEnoughBalance
                        ? "none"
                        : "block";
                }
            };

            radioInputs.forEach((input) => {
                input.addEventListener("change", updateState);
            });

            quantityInput?.addEventListener("input", updateState);

            updateState();
        }
    </script>
</BaseLayout>
