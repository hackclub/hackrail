---
import BaseLayout from "../../layouts/base.astro";
import UserHeader from "../../components/UserHeader.astro";
import { GetUserFromCookies } from "../../utils/auth";

// build oauth url
const client_id = import.meta.env.PUBLIC_HACKATIME_CLIENT_ID;
const redirect_uri = import.meta.env.PUBLIC_HACKATIME_REDIRECT_URI;

// get user
const user = await GetUserFromCookies(Astro.cookies);
if (!user) return Astro.redirect("/login");

const oauthUrl = `https://hackatime.hackclub.com/oauth/authorize?client_id=${client_id}&redirect_uri=${redirect_uri}&response_type=code&scope=profile+read`;
---

<BaseLayout title="Link" hideFooter={true}>
    <UserHeader user={user} />
    <div class="margin">
        <div class="link-container">
            <h1>Hackatime link required</h1>
            <p>
                we need access to your hackatime data before you can create
                projects :0 <br /> (this will only be used to read time spent on
                each project you select/list all of your projects!)
            </p>
            <a class="button" href={oauthUrl}>
                link hackatime
            </a>
        </div>
    </div>
</BaseLayout>
