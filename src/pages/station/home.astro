---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/base.astro";
import "../../styles/home.css";
import { GetUserFromCookies } from "../../utils/auth.ts";
import { GetProjectsForUser } from "../../utils/misc.ts";
import {
    GetHackatimeProjects,
    type HackatimeProject,
} from "../../utils/hackatime";
import { formatSeconds } from "../../utils/time";
import type { Project } from "../../db/schema";
import UserHeader from "../../components/UserHeader.astro";
import { separateText, type TextBlock } from "../../utils/text";

// get error from cookies
const error = Astro.cookies.get("flash_error")?.value;
if (error) {
    Astro.cookies.delete("flash_error", { path: "/" });
}

const user = await GetUserFromCookies(Astro.cookies);
// now get user projects
if (!user) {
    return Astro.redirect("/login");
}
const projects = await GetProjectsForUser(user.slackId);
const hackData = await GetHackatimeProjects(user.slackId);
var hackatimeProjects: HackatimeProject[];
if (hackData.ok) {
    hackatimeProjects = hackData.projects || [];
} else {
    hackatimeProjects = [];
}

// map of project id to time spent (str)
var projectTimeSpent: { [key: string]: string } = {};

var totalTimeSpent = 0;
var totalTimeUnshipped = 0;
var totalTimeUnreviewed = 0;
var totalTimeRejected = 0;
var totalTimeApproved = 0;

for (const project of projects) {
    var timeSpent = 0;
    var hackatimeProjectNames = JSON.parse(project.hackatimeProjects);

    for (const hackatimeProject of hackatimeProjects) {
        if (hackatimeProjectNames.includes(hackatimeProject.name)) {
            // project found in hackatime, add time spent
            if (project.approved) {
                totalTimeApproved += hackatimeProject.total_seconds;
            } else if (project.rejected) {
                totalTimeRejected += hackatimeProject.total_seconds;
            } else if (project.shipped) {
                totalTimeUnreviewed += hackatimeProject.total_seconds;
            } else {
                totalTimeUnshipped += hackatimeProject.total_seconds;
            }

            // add time to total time spent
            totalTimeSpent += hackatimeProject.total_seconds;
            // add time to this specific project's time spent
            timeSpent += hackatimeProject.total_seconds;
        }
    }

    projectTimeSpent[project.id] = formatSeconds(timeSpent);
}

// load shop items
import shopItems from "../../assets/shop.json";
import { type CardItem } from "../../components/MultipurposeCard.astro";
import MultiPurposeCard from "../../components/MultipurposeCard.astro";
---

<BaseLayout title="Home" hideFooter={false}>
    {error && (
        <div
            class="surface dangerbg"
            style="width: 100%; border-radius: 0; padding: 1rem; margin-bottom: 1rem;"
        >
            <p>{error}</p>
        </div>
    )}

    <UserHeader user={user} />

    <div class="page">
        <div class="time">
            <h1 class="time-title">
                {totalTimeSpent === 0
                    ? "no hours logged yet ª"
                    : `total time spent: ${formatSeconds(totalTimeSpent)}`}
            </h1>
            <div class="progressbar">
                <div
                    class="progressbar-fill unshipped"
                    style={`width: ${
                        totalTimeSpent > 0
                            ? (totalTimeUnshipped / totalTimeSpent) * 100
                            : 0
                    }%`}
                ></div>
                <div
                    class="progressbar-fill unreviewed"
                    style={`width: ${
                        totalTimeSpent > 0
                            ? (totalTimeUnreviewed / totalTimeSpent) * 100
                            : 0
                    }%`}
                ></div>
                <div
                    class="progressbar-fill approved"
                    style={`width: ${
                        totalTimeSpent > 0
                            ? (totalTimeApproved / totalTimeSpent) * 100
                            : 0
                    }%`}
                ></div>
                <div
                    class="progressbar-fill rejected"
                    style={`width: ${
                        totalTimeSpent > 0
                            ? (totalTimeRejected / totalTimeSpent) * 100
                            : 0
                    }%`}
                ></div>
            </div>
            <div class="progressbar-labels">
                <div class="color-box unshipped"></div>
                <span>unshipped</span>
                <div class="color-box unreviewed"></div>
                <span>unreviewed</span>
                <div class="color-box approved"></div>
                <span>approved</span>
                <div class="color-box rejected"></div>
                <span>rejected</span>
            </div>
        </div>
        <div class="projects">
            <div class="row ycentered gap">
                <h1>your projects</h1>
                <a class="button" href="/station/projects/create">
                    @
                </a>
                <a class="guides-link" href="/station/help">
                    <p class="guides">you don't know what to build?</p>
                    <span class="arrow">…</span>
                </a>
            </div>
            {projects.length === 0 && (
                <div class="surface warnbg">
                    <p>
                        you have no projects yet! click the @ button to create
                        one.
                    </p>
                </div>
            )}

            <div class="row gap project-strip">
                {projects.map((project: Project) => {
                    const projectCard: CardItem = {
                        id: project.id.toString(),
                        name: project.projectName,
                        description: project.projectDescription,
                        imageUrl: project.projectScreenshot || "",
                        chip: true,
                        chipText: projectTimeSpent[project.id] || "0h 0m",
                        itemLink: `/station/project/${project.id}`,
                    };
                    return <MultiPurposeCard item={projectCard} />;
                })}
            </div>
        </div>
        <div class="shop">
            <div class="row ycentered gap">
                <h1>featured shop items \[</h1>
                <a class="button" href="/station/shop">
                    view all
                </a>
            </div>
            <div class="row gap project-strip">
                {shopItems.map((item) => {
                    if (item.featured) {
                        var priceText = item.options[0].price + " =";
                        if (item.options.length > 1) {
                            priceText = "from " + priceText;
                        }

                        const cardItem: CardItem = {
                            id: item.id,
                            name: item.name,
                            description: item.description,
                            imageUrl: "/shop/" + item.image,
                            chip: true,
                            chipText: priceText,
                            itemLink: `/station/shop/${item.id}`,
                        };
                        return <MultiPurposeCard item={cardItem} />;
                    }
                })}
            </div>
        </div>
    </div>
</BaseLayout>
