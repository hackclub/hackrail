---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/base.astro";
import "../../styles/home.css";
import { GetUserFromCookies } from "../../utils/auth.ts";
import { GetProjectsForUser } from "../../utils/misc.ts";
import {
    GetHackatimeProjects,
    type HackatimeProject,
} from "../../utils/hackatime";
import { formatSeconds } from "../../utils/time";
import type { Project } from "../../db/schema";
import UserHeader from "../../components/UserHeader.astro";
import { separateText, type TextBlock } from "../../utils/text";

// get error from cookies
const error = Astro.cookies.get("flash_error")?.value;
if (error) {
    Astro.cookies.delete("flash_error", { path: "/" });
}

const user = await GetUserFromCookies(Astro.cookies);
// now get user projects
if (!user) {
    return Astro.redirect("/login");
}
const projects = await GetProjectsForUser(user.slackId);
const hackData = await GetHackatimeProjects(user.slackId);
var hackatimeProjects: HackatimeProject[];
if (hackData.ok) {
    hackatimeProjects = hackData.projects || [];
} else {
    hackatimeProjects = [];
}

// map of project id to time spent (str)
var projectTimeSpent: { [key: string]: string } = {};
var totalTimeSpent = 0;

var totalTimeUnshipped = 0;
var totalTimeUnreviewed = 0;
var totalTimeRejected = 0;
var totalTimeApproved = 0;

for (const project of projects) {
    var timeSpent = 0;
    var hackatimeProjectNames = JSON.parse(project.hackatimeProjects);

    for (const hackatimeProject of hackatimeProjects) {
        if (hackatimeProjectNames.includes(hackatimeProject.name)) {
            totalTimeSpent += hackatimeProject.total_seconds || 0;
            timeSpent += hackatimeProject.total_seconds || 0;
        }
    }

    // categorize time spent by project status
    if (project.shipped) {
        const projectReviewed = !project.approved && !project.rejected;
        if (!projectReviewed) {
            totalTimeUnreviewed += timeSpent;
        } else if (project.approved) {
            totalTimeApproved += timeSpent;
        } else if (project.rejected) {
            totalTimeRejected += timeSpent;
        }
    } else {
        totalTimeUnshipped += timeSpent;
    }

    projectTimeSpent[project.id] = formatSeconds(timeSpent);
}

// load shop items
import shopItems from "../../assets/shop.json";
---

<BaseLayout title="Home" hideFooter={false}>
    {
        error && (
            <div
                class="surface dangerbg"
                style="width: 100%; border-radius: 0; padding: 1rem; margin-bottom: 1rem;"
            >
                <p>{error}</p>
            </div>
        )
    }

    <UserHeader user={user} />

    <div class="page">
        <div class="time">
            <h1 class="time-title">
                {
                    totalTimeSpent === 0
                        ? "no hours logged yet ª"
                        : `total time spent: ${formatSeconds(totalTimeSpent)}`
                }
            </h1>
            <div class="progressbar">
                <div
                    class="progressbar-fill unshipped"
                    style={`width: ${
                        totalTimeSpent > 0
                            ? (totalTimeUnshipped / totalTimeSpent) * 100
                            : 0
                    }%`}
                >
                </div>
                <div
                    class="progressbar-fill unreviewed"
                    style={`width: ${
                        totalTimeSpent > 0
                            ? (totalTimeUnreviewed / totalTimeSpent) * 100
                            : 0
                    }%`}
                >
                </div>
                <div
                    class="progressbar-fill approved"
                    style={`width: ${
                        totalTimeSpent > 0
                            ? (totalTimeApproved / totalTimeSpent) * 100
                            : 0
                    }%`}
                >
                </div>
                <div
                    class="progressbar-fill rejected"
                    style={`width: ${
                        totalTimeSpent > 0
                            ? (totalTimeRejected / totalTimeSpent) * 100
                            : 0
                    }%`}
                >
                </div>
            </div>
            <div class="progressbar-labels">
                <div class="color-box unshipped"></div>
                <span>unshipped</span>
                <div class="color-box unreviewed"></div>
                <span>unreviewed</span>
                <div class="color-box approved"></div>
                <span>approved</span>
                <div class="color-box rejected"></div>
                <span>rejected</span>
            </div>
        </div>
        <div class="projects">
            <div class="row ycentered gap">
                <h1>your projects</h1>
                <a class="button" href="/station/projects/create">@</a>
            </div>
            {
                projects.length === 0 && (
                    <div class="surface warnbg">
                        <p>
                            you have no projects yet! click the @ button to
                            create one.
                        </p>
                    </div>
                )
            }

            <div class="row gap project-strip">
                {
                    projects.map((project: Project) => (
                        <a
                            href={`/station/project/${project.id}`}
                            class="projectcard-link"
                        >
                            <div
                                class="
                    projectcard"
                            >
                                <div class="projectcard-image-container">
                                    <div class="projectcard-time-spent">
                                        {projectTimeSpent[project.id] || "0s"}
                                    </div>
                                    <Image
                                        class="projectcard-image"
                                        src={project.projectScreenshot || ""}
                                        width={128}
                                        height={128}
                                        alt="project image"
                                    />
                                </div>
                                <div class="projectcard-content">
                                    <h2 class="limited">
                                        {project.projectName}
                                    </h2>
                                    <p class="desc limited">
                                        {project.projectDescription}
                                    </p>
                                </div>
                            </div>
                        </a>
                    ))
                }
            </div>
        </div>
        <div class="shop">
            <div class="row ycentered gap">
                <h1>featured shop items \[</h1>
                <a class="button" href="/station/shop">view all</a>
            </div>
            <div class="row gap project-strip">
                {
                    shopItems.map(
                        (item) =>
                            item.featured && (
                                <a
                                    href={`/station/shop/${item.id}`}
                                    class="projectcard-link"
                                >
                                    <div class="projectcard">
                                        <div class="projectcard-image-container">
                                            <img
                                                class="projectcard-image"
                                                src={"/shop/" + item.image}
                                                width={128}
                                                height={128}
                                                alt="shop item image"
                                            />
                                        </div>
                                        <div class="projectcard-content">
                                            <h2 class="limited">{item.name}</h2>
                                            <p class="desc limited">
                                                {separateText(
                                                    item.description,
                                                ).map((block: TextBlock) => (
                                                    <span
                                                        class={
                                                            block.isInBreakList
                                                                ? "remove-font"
                                                                : undefined
                                                        }
                                                    >
                                                        {block.text}
                                                    </span>
                                                ))}
                                            </p>
                                        </div>
                                    </div>
                                </a>
                            ),
                    )
                }
            </div>
        </div>
    </div>
</BaseLayout>
