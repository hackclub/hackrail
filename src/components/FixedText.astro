---
import { separateText, type TextBlock } from "../utils/text";

interface Props {
    text: string;
    limited?: boolean;
}

const { text, limited } = Astro.props;
---

{separateText(text).map((block: TextBlock) => (
    <span
        class={block.isInBreakList ? "remove-font" : undefined}
        class={limited ? "limited" : undefined}
    >
        {block.text}
    </span>
))}
