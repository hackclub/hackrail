---
import { separateText, type TextBlock } from "../utils/text";
import "./card.css";
import FixedText from "./FixedText.astro";

export type CardItem = {
    id: string;
    name: string;
    description: string;
    imageUrl: string;
    chip: boolean;
    chipText: string;
    itemLink: string;
    secondChip?: boolean;
    secondChipText?: string;
    secondChipColor?: "primary" | "success" | "warn" | "danger";
};

interface Props {
    item: CardItem;
    scale?: number;
    unClickable?: boolean;
}

const { item, scale, unClickable = false } = Astro.props;
---

<a href={unClickable == false ? item.itemLink : undefined} class="card-link">
    <div class="multicard" style={`transform: scale(${scale || 1})`}>
        <div class="card-image-container">
            {item.chip && <div class="card-chip">{item.chipText}</div>}
            {item.secondChip && (
                <div class={`card-chip second ${item.secondChipColor + "bg"}`}>
                    {item.secondChipText}
                </div>
            )}
            <img
                class="card-image"
                src={item.imageUrl}
                width={128}
                height={128}
                alt="item image"
                id="card-image"
            />
        </div>
        <div class="card-content">
            <h2 class="limited">{item.name}</h2>
            <p class="desc limited">
                <FixedText limited={true} text={item.description} />
            </p>
        </div>
    </div>
</a>
