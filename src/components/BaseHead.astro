---
interface Props {
    title: string;
    embedTitleReplacement?: string;
    embedDescriptionReplacement?: string;
    embedImageReplacement?: string;
}

const {
    title,
    embedTitleReplacement,
    embedDescriptionReplacement,
    embedImageReplacement,
} = Astro.props;
---

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content="ship projects -> get on trains!" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={embedTitleReplacement || title} />
    <meta
        property="og:description"
        content={
            embedDescriptionReplacement || "ship projects -> get on trains!"
        }
    />
    <meta
        property="og:image"
        content={embedImageReplacement || "/og-image.png"}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={embedTitleReplacement || title} />
    <meta
        name="twitter:description"
        content={
            embedDescriptionReplacement || "ship projects -> get on trains!"
        }
    />
    <meta
        name="twitter:image"
        content={embedImageReplacement || "/og-image.png"}
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
